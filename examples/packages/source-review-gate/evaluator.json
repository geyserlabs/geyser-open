{
  "schema_version": 1,
  "name": "source-review-gate",
  "description": "Check that every supplied claim cites known source identifiers; this does not verify factual truth.",
  "handler": "handler.py:run",
  "effect_class": "pure",
  "input_schema": {
    "type": "object",
    "required": [
      "source_ids",
      "claims"
    ],
    "properties": {
      "source_ids": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "maxLength": 100
        }
      },
      "claims": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "text",
            "source_ids"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 2000
            },
            "source_ids": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "passed",
      "unsupported_claims"
    ],
    "properties": {
      "passed": {
        "type": "boolean"
      },
      "unsupported_claims": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "additionalProperties": false
  }
}
