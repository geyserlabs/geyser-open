{
  "additionalProperties": false,
  "description": "Start a new project task from the original input with fresh authority.",
  "properties": {
    "authority_ref": {
      "default": "",
      "maxLength": 512,
      "title": "Authority Ref",
      "type": "string"
    },
    "budget": {
      "additionalProperties": true,
      "title": "Budget",
      "type": "object"
    },
    "expected_sequence": {
      "minimum": 1,
      "title": "Expected Sequence",
      "type": "integer"
    },
    "fork_key": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Fork Key",
      "type": "string"
    },
    "mode": {
      "enum": [
        "model_only",
        "tool_stubbed",
        "read_only_shadow",
        "full_reexecution"
      ],
      "title": "Mode",
      "type": "string"
    },
    "sanitized": {
      "default": false,
      "title": "Sanitized",
      "type": "boolean"
    },
    "stubs_ref": {
      "default": "",
      "maxLength": 1000,
      "title": "Stubs Ref",
      "type": "string"
    },
    "target_framework": {
      "default": "",
      "maxLength": 64,
      "title": "Target Framework",
      "type": "string"
    },
    "target_model_profile_digest": {
      "default": "",
      "maxLength": 80,
      "title": "Target Model Profile Digest",
      "type": "string"
    },
    "target_model_ref": {
      "default": "",
      "maxLength": 512,
      "title": "Target Model Ref",
      "type": "string"
    },
    "target_policy_ref": {
      "default": "",
      "maxLength": 512,
      "title": "Target Policy Ref",
      "type": "string"
    }
  },
  "required": [
    "fork_key",
    "expected_sequence",
    "mode"
  ],
  "title": "ReplayCreate",
  "type": "object"
}
